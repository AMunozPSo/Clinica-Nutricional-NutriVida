# Proxy inverso de NutriVida: sirve el frontend compilado y reparte /api/v1
# entre los cuatro microservicios. Con un dominio en SITE_ADDRESS, Caddy
# obtiene y renueva el certificado HTTPS automáticamente.
{$SITE_ADDRESS::80} {
	encode gzip

	@usuarios path_regexp ^/api/v1/(auth|usuarios|profesionales)(/.*)?$
	handle @usuarios {
		reverse_proxy usuarios:8081
	}

	@catalogo path_regexp ^/api/v1/(servicios|categorias)(/.*)?$
	handle @catalogo {
		reverse_proxy catalogo:8082
	}

	@atencion path_regexp ^/api/v1/(citas|pacientes|planes|progreso|contacto)(/.*)?$
	handle @atencion {
		reverse_proxy atencion:8083
	}

	@ventas path_regexp ^/api/v1/pedidos(/.*)?$
	handle @ventas {
		reverse_proxy ventas:8084
	}

	# Frontend React: cualquier ruta desconocida vuelve a index.html (SPA).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
