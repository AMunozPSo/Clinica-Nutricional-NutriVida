[Unit]
Description=NutriVida (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nutrivida
ExecStart=/usr/bin/docker compose --env-file /opt/nutrivida/.env -f /opt/nutrivida/compose.yaml up -d --no-build
ExecStop=/usr/bin/docker compose --env-file /opt/nutrivida/.env -f /opt/nutrivida/compose.yaml stop
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
